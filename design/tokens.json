{
  "$description": "Stowaway design tokens, direction Ledger (warm paper, ink, serif figures, rules instead of boxes). Source of truth: run `node design/tokens.mjs` to regenerate design/prototype/tokens.css and check WCAG AA contrast.",
  "color": {
    "light": {
      "bg.content": "#F6F1E7",
      "bg.sidebar": "rgba(236, 229, 214, 0.72)",
      "bg.surface": "#EFE8DA",
      "bg.inset": "#E3DAC8",
      "bg.raised": "#FFFAF0",
      "bg.overlay": "rgba(29, 36, 51, 0.30)",
      "line.hairline": "#D8CFBC",
      "line.strong": "#CFC5B0",
      "text.primary": "#1D2433",
      "text.secondary": "#5A5A52",
      "text.tertiary": "#62625A",
      "text.disabled": "#A39E90",
      "text.onFill": "#FFF8EF",
      "accent.fill": "#C8401F",
      "accent.text": "#A5300F",
      "accent.tint": "rgba(200, 64, 31, 0.13)",
      "ok.fill": "#2F7A4F",
      "ok.text": "#23603C",
      "ok.tint": "rgba(47, 122, 79, 0.15)",
      "warn.fill": "#B86A00",
      "warn.text": "#804700",
      "warn.tint": "rgba(184, 106, 0, 0.17)",
      "danger.fill": "#A8173A",
      "danger.text": "#94123A",
      "danger.tint": "rgba(168, 23, 58, 0.11)",
      "cable.blue": "#1F5FA8",
      "cable.orange": "#B85C00",
      "cable.violet": "#5B4BD6",
      "cable.green": "#2F7A4F",
      "cable.pink": "#A8326B",
      "cable.teal": "#0E7C7B",
      "cable.loose": "#A8173A",
      "jack.hole": "#1D2433",
      "jack.ring": "#7A7566",
      "storage.system": "#8B8676",
      "storage.apps": "#B9B19D",
      "storage.other": "#D6CDB9"
    },
    "dark": {
      "bg.content": "#141923",
      "bg.sidebar": "rgba(15, 19, 27, 0.72)",
      "bg.surface": "#1A2030",
      "bg.inset": "#252B38",
      "bg.raised": "#222938",
      "bg.overlay": "rgba(0, 0, 0, 0.50)",
      "line.hairline": "#2B3140",
      "line.strong": "#3A4254",
      "text.primary": "#EFE8D8",
      "text.secondary": "#ABA595",
      "text.tertiary": "#9A9585",
      "text.disabled": "#5F5F58",
      "text.onFill": "#1A0D08",
      "accent.fill": "#FF7A52",
      "accent.text": "#FF9A7A",
      "accent.tint": "rgba(255, 122, 82, 0.16)",
      "ok.fill": "#5CC58A",
      "ok.text": "#7FDCA6",
      "ok.tint": "rgba(92, 197, 138, 0.15)",
      "warn.fill": "#F0A63A",
      "warn.text": "#F6C16E",
      "warn.tint": "rgba(240, 166, 58, 0.15)",
      "danger.fill": "#FF6F91",
      "danger.text": "#FF8FA9",
      "danger.tint": "rgba(255, 111, 145, 0.14)",
      "cable.blue": "#6FB1FF",
      "cable.orange": "#FF9A4D",
      "cable.violet": "#A99BFF",
      "cable.green": "#5CC58A",
      "cable.pink": "#FF7AB0",
      "cable.teal": "#3DD6D0",
      "cable.loose": "#FF6F91",
      "jack.hole": "#0B0E14",
      "jack.ring": "#7C7F86",
      "storage.system": "#6D6A5F",
      "storage.apps": "#4A4A45",
      "storage.other": "#33363D"
    }
  },
  "contrast": {
    "$description": "Pairs checked by tokens.mjs in both themes. text = 4.5:1 (AA body), graphic = 3:1 (AA non-text).",
    "text": [
      ["text.primary", "bg.content"], ["text.primary", "bg.surface"], ["text.primary", "bg.inset"], ["text.primary", "bg.raised"],
      ["bg.content", "text.primary"],
      ["text.secondary", "bg.content"], ["text.secondary", "bg.surface"], ["text.secondary", "bg.inset"], ["text.secondary", "bg.raised"],
      ["text.tertiary", "bg.content"], ["text.tertiary", "bg.surface"],
      ["accent.text", "bg.content"], ["accent.text", "bg.surface"], ["text.onFill", "accent.fill"],
      ["ok.text", "bg.content"], ["ok.text", "bg.surface"], ["warn.text", "bg.content"], ["warn.text", "bg.surface"],
      ["danger.text", "bg.content"], ["danger.text", "bg.surface"], ["text.onFill", "danger.fill"]
    ],
    "graphic": [
      ["cable.blue", "bg.content"], ["cable.orange", "bg.content"], ["cable.violet", "bg.content"],
      ["cable.green", "bg.content"], ["cable.pink", "bg.content"], ["cable.teal", "bg.content"],
      ["cable.loose", "bg.content"], ["ok.fill", "bg.content"], ["warn.fill", "bg.content"], ["danger.fill", "bg.content"],
      ["accent.fill", "bg.content"], ["jack.ring", "bg.content"]
    ]
  },
  "font": {
    "text": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
    "num": "ui-serif, \"New York\", \"Iowan Old Style\", Georgia, serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "type": {
    "$description": "num is the serif: page titles, the forecast sentence and every figure. mono is for file paths only.",
    "title":    { "family": "num",  "size": 28, "line": 32, "weight": 700, "tracking": -0.01 },
    "display":  { "family": "num",  "size": 30, "line": 36, "weight": 600, "tracking": -0.015 },
    "headline": { "family": "text", "size": 15, "line": 20, "weight": 600, "tracking": 0 },
    "body":     { "family": "text", "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "emphasis": { "family": "text", "size": 13, "line": 18, "weight": 600, "tracking": 0 },
    "callout":  { "family": "text", "size": 12, "line": 16, "weight": 400, "tracking": 0 },
    "caption":  { "family": "text", "size": 11, "line": 14, "weight": 400, "tracking": 0 },
    "group":    { "family": "num",  "size": 13, "line": 16, "weight": 400, "tracking": 0, "style": "italic" },
    "figure":   { "family": "num",  "size": 30, "line": 34, "weight": 500, "tracking": -0.01 },
    "number":   { "family": "num",  "size": 14, "line": 18, "weight": 500, "tracking": 0 },
    "path":     { "family": "mono", "size": 11, "line": 14, "weight": 400, "tracking": 0 }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20, "8": 24, "9": 32, "10": 40 },
  "radius": { "xs": 3, "sm": 5, "md": 6, "lg": 8, "xl": 10, "full": 999 },
  "elevation": {
    "$description": "1 is a ruled edge, not a shadow: buttons and the pressed segment sit on paper. 3 and 4 are for the popover and the sheet.",
    "light": {
      "0": "none",
      "1": "0 0 0 1px #CFC5B0",
      "2": "0 1px 2px rgba(29, 36, 51, 0.10), 0 0 0 1px #D8CFBC",
      "3": "0 8px 24px rgba(29, 36, 51, 0.16), 0 0 0 1px #CFC5B0",
      "4": "0 22px 60px rgba(29, 36, 51, 0.26), 0 0 0 1px #CFC5B0"
    },
    "dark": {
      "0": "none",
      "1": "0 0 0 1px #3A4254",
      "2": "0 1px 2px rgba(0, 0, 0, 0.45), 0 0 0 1px #2B3140",
      "3": "0 8px 24px rgba(0, 0, 0, 0.5), 0 0 0 1px #3A4254",
      "4": "0 22px 60px rgba(0, 0, 0, 0.6), 0 0 0 1px #3A4254"
    }
  },
  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 320, "cable": 520 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "settle": "cubic-bezier(0.34, 1.36, 0.64, 1)"
    },
    "$reducedMotion": "With prefers-reduced-motion, every duration becomes 0 except opacity fades (fast)."
  }
}
