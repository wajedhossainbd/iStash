{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "iStash",
  "version": "0.1.0",
  "identifier": "bd.wajed.stowaway",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "iStash",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 30
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "popover",
        "title": "iStash",
        "url": "index.html#/popover",
        "width": 380,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 16
        },
        "theme": "Dark"
      },
      {
        "label": "widget",
        "title": "iStash",
        "url": "index.html#/widget",
        "width": 140,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 18
        },
        "theme": "Dark"
      },
      {
        "label": "island",
        "title": "iStash",
        "url": "island.html",
        "width": 380,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-only",
    "copyright": "© 2026 Wajed Hossain. GPL-3.0",
    "shortDescription": "Move heavy app data to an external drive and keep every app working."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNzJEM0MwQjlGNkQwNjkKUldScDBQYTV3Tk55TWpWOEFJRUQ4K1dKOFdlYjRPdWk1aGwyRVhLTmprdWR1Z284eWppODB4eGwK",
      "endpoints": [
        "https://github.com/wajedhossainbd/iStash/releases/latest/download/latest.json"
      ]
    }
  }
}
